        "jsCode": "const fields = $input.first().json.body.data.fields;\n\nconst KEY = {\n  name: 'question_qE1vr7',\n  studentId: 'question_QBlkZp',\n  email: 'question_9JjMkY',\n  department: 'question_exWvJO',\n  description: 'question_WpV1Wa',\n  file: 'question_arqvLq',\n};\n\nconst get = (k) => fields.find(f => f.key === k);\n\nconst text = (k) => get(k)?.value ?? null;\n\nconst choice = (k) => {\n  const f = get(k);\n\n  if (!f?.value?.length) return null;\n\n  return f.options.find(o => o.id === f.value[0])?.text?.trim() ?? null;\n};\n\nconst out = {\n  student_name: text(KEY.name),\n  student_id: text(KEY.studentId),\n  email: text(KEY.email),\n  department: choice(KEY.department),\n  description: text(KEY.description),\n  attachment_url: get(KEY.file)?.value?.[0]?.url ?? null,\n};\n\nfor (const k of [\n  'student_name',\n  'student_id',\n  'email',\n  'department',\n  'description'\n]) {\n  if (!out[k]) {\n    throw new Error(`Missing required field: ${k}`);\n  }\n}\n\nreturn [{ json: out }];"
      },
